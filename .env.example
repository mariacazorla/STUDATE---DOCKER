# Plantilla de configuración del despliegue. Cópiala con el nombre .env (cp .env.example .env) y cambia
# los valores. El .env no se sube a GitHub: lleva los secretos.

# Nombre de la base de datos dentro del MongoDB del compose
MONGO_DB=studate

# Puertos del servidor en los que escucha nginx (la web y, por /api, la API). El de https solo se usa
# con compose.https.yml
WEB_PORT=80
WEB_PORT_HTTPS=443

# Dirección pública con la que se abre Studate en el navegador, sin barra al final. Si hay más de una
# (por ejemplo, la IP y un dominio), separadas por comas
CORS_ORIGINS=http://localhost

# true solo cuando Studate se sirve por HTTPS. Con http tiene que ser false: si no, el navegador no
# guarda la cookie del refresh token y nadie puede mantener la sesión
COOKIE_SECURE=false

# Secretos con los que la API firma los tokens. Obligatorios y distintos entre sí. Se generan con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-32-bytes-aleatorios-en-hexadecimal
JWT_REFRESH_SECRET=cambia-esto-por-otros-32-bytes-aleatorios-en-hexadecimal

# Cuánto dura cada token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Qué imagen se despliega: latest (lo que hay en main) o develop (lo que hay en develop)
IMAGE_TAG=latest
